digraph G {
  rankdir=LR; bgcolor="transparent"; pad=0.2; nodesep=0.3; ranksep=0.5; compound=true;
  node [shape=box style="rounded,filled" fillcolor="white" color="#1B1F24" penwidth=1.6 fontname="Space Grotesk" fontsize=13 fontcolor="#1B1F24" margin="0.18,0.08"];
  edge [color="#1B1F24" penwidth=1.3 arrowsize=0.7 fontname="JetBrains Mono" fontsize=10 fontcolor="#5A6270"];
  subgraph cluster_edge { label="BANK / TELCO EDGE"; fontname="JetBrains Mono"; fontsize=10; fontcolor="#5A6270"; style="dashed,rounded"; color="#9AA3AE";
    audio [label="Call audio" shape=ellipse]; feat [label="Feature extraction"]; }
  subgraph cluster_cloud { label="DETECTION CLOUD"; fontname="JetBrains Mono"; fontsize=10; fontcolor="#5A6270"; style="dashed,rounded"; color="#9AA3AE";
    subgraph cluster_ens { label="Detector ensemble"; fontname="Space Grotesk"; fontcolor="#B4521A"; style="rounded,filled"; fillcolor="#FFF7EE"; color="#E8772E";
      d1 [label="Synthetic-voice" fillcolor="#FFE9D3" color="#E8772E"]; d2 [label="Scam-script intent" fillcolor="#FFE9D3" color="#E8772E"]; d3 [label="SIM-swap signals" fillcolor="#FFE9D3" color="#E8772E"]; }
    fuse [label="Risk fusion" fillcolor="#1B1F24" fontcolor="white"];
    step [label="Step-up auth" fillcolor="#DDF0EC" color="#127A72"]; human [label="Human review" fillcolor="#DDF0EC" color="#127A72"];
    vault [label="Evidence vault" shape=cylinder fillcolor="#E9E4F5"]; }
  audio -> feat [label="20 ms frames"]; feat -> {d1 d2 d3}; {d1 d2 d3} -> fuse;
  fuse -> step [label="p>0.6" color="#127A72"]; fuse -> human [label="p>0.9" color="#C8372D"]; fuse -> vault [style=dashed];
}
